<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"/>

    <View
            android:id="@+id/scan_hole"
            android:layout_width="300dp"
            android:layout_height="150dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

    <View
            android:layout_width="304dp"
            android:layout_height="154dp"
            android:background="@drawable/scanner_border"
            app:layout_constraintTop_toTopOf="@id/scan_hole"
            app:layout_constraintBottom_toBottomOf="@id/scan_hole"
            app:layout_constraintLeft_toLeftOf="@id/scan_hole"
            app:layout_constraintRight_toRightOf="@id/scan_hole"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nakieruj kod na ramkę"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/scan_hole"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>